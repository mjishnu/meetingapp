<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MeetingRecorder.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Meeting Recorder">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Meeting Recorder"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneToggleRequested="OnPaneToggleRequested" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="640"
            DisplayModeChanged="OnNavDisplayModeChanged"
            ExpandedModeThresholdWidth="900"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="220"
            PaneDisplayMode="Auto">

            <NavigationView.PaneHeader>
                <StackPanel
                    Margin="16,12,12,16"
                    Orientation="Horizontal"
                    Spacing="12"
                    AutomationProperties.AccessibilityView="Raw">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="20" Height="20">
                            <Rectangle Canvas.Left="1" Canvas.Top="8" Width="2" Height="4" Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" />
                            <Rectangle Canvas.Left="5" Canvas.Top="4" Width="2" Height="12" Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" />
                            <Rectangle Canvas.Left="9" Canvas.Top="0" Width="2" Height="20" Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" />
                            <Rectangle Canvas.Left="13" Canvas.Top="5" Width="2" Height="10" Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" />
                            <Rectangle Canvas.Left="17" Canvas.Top="8" Width="2" Height="4" Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource PaneTitleTextStyle}"
                        Text="Meeting Recorder" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="AllRecordingsItem"
                    Content="All recordings"
                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>
    </Grid>
</Window>
