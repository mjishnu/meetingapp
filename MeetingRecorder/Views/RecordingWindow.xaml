<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MeetingRecorder.Views.RecordingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:MeetingRecorder.Controls"
    xmlns:h="using:MeetingRecorder.Helpers"
    Title="Meeting Recorder">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Storyboard x:Name="PulseStoryboard" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation
                    Storyboard.TargetName="RecordingDot"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0.3"
                    Duration="0:0:0.9">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="WindowTitleBar"
            Title="Meeting Recorder"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False" />

        <Grid Grid.Row="1" Padding="20,4,20,16">
            <ToggleButton
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Canvas.ZIndex="1"
                x:Name="KeepOnTopToggle"
                Width="32"
                Height="32"
                Margin="0,-4,-8,0"
                Padding="0"
                AutomationProperties.Name="Keep on top"
                Background="Transparent"
                BorderThickness="0"
                Checked="OnKeepOnTopChanged"
                ToolTipService.ToolTip="Keep on top"
                Unchecked="OnKeepOnTopChanged">
                <FontIcon FontSize="14" Glyph="&#xE718;" />
            </ToggleButton>

            <!--  Starting  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}">
                <ProgressRing
                    Width="28"
                    Height="28"
                    IsActive="{x:Bind ViewModel.IsStarting, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Starting…" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    Text="Getting your microphone and speakers ready."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Recording  -->
            <Grid
                RowSpacing="12"
                Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,32,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        x:Name="RecordingDot"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource RecordingIndicatorBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Recording" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        Text="{x:Bind ViewModel.SourceText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,-4,0,0"
                    AutomationProperties.Name="Elapsed time"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />

                <Grid
                    Grid.Row="2"
                    ColumnSpacing="12"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="Microphone"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MicrophoneDescription, Mode=OneWay}" />
                    <ProgressBar
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="{x:Bind ViewModel.MicrophoneDescription, Mode=OneWay}"
                        AutomationProperties.Name="Microphone level"
                        Maximum="100"
                        Style="{StaticResource LevelMeterProgressBarStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MicrophoneDescription, Mode=OneWay}"
                        Value="{x:Bind h:Bind.Percent(ViewModel.MicLevel), Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="System audio" />
                    <ProgressBar
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="System audio level"
                        Maximum="100"
                        Style="{StaticResource LevelMeterProgressBarStyle}"
                        Visibility="{x:Bind ViewModel.HasSystemAudio, Mode=OneWay}"
                        Value="{x:Bind h:Bind.Percent(ViewModel.SystemLevel), Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="Not being captured"
                        Visibility="{x:Bind h:Bind.Collapsed(ViewModel.HasSystemAudio), Mode=OneWay}" />
                </Grid>

                <StackPanel
                    Grid.Row="3"
                    VerticalAlignment="Top"
                    Spacing="4">
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="No microphone input detected. Are you muted?"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowSilentMicHint, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.WarningText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasWarning, Mode=OneWay}" />
                </StackPanel>

                <Button
                    x:Name="StopButton"
                    Grid.Row="4"
                    MinHeight="40"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Stop and save"
                    Command="{x:Bind ViewModel.StopCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Stop and save (Ctrl+S)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                        <TextBlock Text="Stop and save" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Saving  -->
            <StackPanel
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay}">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Saving…" />
                <ProgressBar
                    AutomationProperties.Name="Saving progress"
                    Maximum="100"
                    Value="{x:Bind ViewModel.SaveProgress, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    Text="Finishing your recording. This only takes a moment."
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Saved  -->
            <Grid
                RowSpacing="8"
                Visibility="{x:Bind ViewModel.IsSaved, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="20"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;" />
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Saved" />
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    Text="{x:Bind ViewModel.SavedTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="2"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SavedNote, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasSavedNote, Mode=OneWay}" />
                <StackPanel
                    Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.ShowInListCommand}"
                        Content="Show in list"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Command="{x:Bind ViewModel.CloseCommand}"
                        Content="Close" />
                </StackPanel>
            </Grid>

            <!--  Failed  -->
            <Grid
                RowSpacing="8"
                Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="20"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;" />
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="96" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        AutomationProperties.LiveSetting="Assertive"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="Your audio is still on this PC. If you close this window, Meeting Recorder will recover it the next time it starts."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasPendingSave, Mode=OneWay}" />
                <ctl:WrapRow
                    Grid.Row="3"
                    HorizontalSpacing="8"
                    VerticalSpacing="8">
                    <Button
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Content="{x:Bind ViewModel.RetryText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Command="{x:Bind ViewModel.OpenPrivacySettingsCommand}"
                        Content="Open privacy settings"
                        Visibility="{x:Bind ViewModel.ShowPrivacySettings, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.OpenSoundSettingsCommand}"
                        Content="Open sound settings"
                        Visibility="{x:Bind ViewModel.ShowSoundSettings, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.CloseCommand}"
                        Content="Close" />
                </ctl:WrapRow>
            </Grid>
        </Grid>
    </Grid>
</Window>
